[sqlfluff]
dialect = duckdb
templater = dbt
runaway_limit = 10
max_line_length = 150
indent_unit = space
# Exclude strict rules that block auto-fixing on Jinja models
exclude_rules = AM06, AL01, LT05

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
profile = saas_analytics_profile
target = dev

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower